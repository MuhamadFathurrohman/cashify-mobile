{
  "expo": {
    "name": "cashify",
    "slug": "cashify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cashify-icon.png",
    "scheme": "cashify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "",
        "backgroundImage": "",
        "monochromeImage": ""
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9ff",
          "image": "./assets/images/logo-icon-cashify.png",
          "imageWidth": 112
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
